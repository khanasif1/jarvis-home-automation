{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-assistant.example/contracts/error-response.json",
  "title": "ErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "correlationId"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean",
          "default": false
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
