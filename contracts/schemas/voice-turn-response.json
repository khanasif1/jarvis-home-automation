{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-assistant.example/contracts/voice-turn-response.json",
  "title": "VoiceTurnResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "conversationId", "text", "correlationId"],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "maxLength": 20000
    },
    "audioBase64": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "audioContentType": {
      "type": "string",
      "enum": ["audio/wav", "audio/mpeg"]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "status"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": ["completed", "pending", "failed"]
          },
          "summary": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "default": []
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "dependentRequired": {
    "audioBase64": ["audioContentType"],
    "audioContentType": ["audioBase64"]
  }
}
