{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-assistant.example/contracts/voice-turn-request.json",
  "title": "VoiceTurnRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "deviceId", "timezone"],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
      "default": "en-US"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "audioBase64": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 8388608
    },
    "audioContentType": {
      "type": "string",
      "enum": ["audio/wav", "audio/x-wav"]
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "oneOf": [
    {
      "required": ["text"],
      "not": {
        "required": ["audioBase64"]
      }
    },
    {
      "required": ["audioBase64", "audioContentType"],
      "not": {
        "required": ["text"]
      }
    }
  ],
  "dependentRequired": {
    "audioBase64": ["audioContentType"],
    "audioContentType": ["audioBase64"]
  }
}
