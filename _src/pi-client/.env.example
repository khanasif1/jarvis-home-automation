# home-assistant-pi device configuration
#
# Copy this file to /etc/home-assistant-pi/config.env on the Raspberry Pi
# (the install/update scripts do this automatically on first install and
# preserve it across upgrades). The install script sets this file to mode
# 0640, owned by root:homeassistant -- root can edit it, and the
# "homeassistant" service account can only read it (group-read), never
# modify it. Do this by hand only if you are not using install.sh:
#   sudo chown root:homeassistant /etc/home-assistant-pi/config.env
#   sudo chmod 0640 /etc/home-assistant-pi/config.env
#
# Never commit a real config.env (with a real device token) to source
# control.

# --- Required ---

# Unique identifier for this device, assigned during device provisioning.
HAP_DEVICE_ID=

# Secret device token used to authenticate to the azure-backend API.
# Treat this like a password. Never share it or log it.
HAP_DEVICE_TOKEN=

# Base URL emitted by the infrastructure deployment. It must include /api,
# e.g. https://myapp.azurewebsites.net/api
HAP_API_BASE_URL=

# --- Optional (defaults shown) ---

# IANA timezone name used for reminder scheduling and log timestamps.
HAP_TIMEZONE=UTC

# Wake-word engine: keyboard | porcupine | openwakeword
# "keyboard" requires no model files and is useful for headless testing;
# it treats pressing Enter on the controlling terminal as the wake event.
#
# IMPORTANT: "keyboard" ONLY works when stdin is an interactive terminal.
# systemd always runs services with stdin redirected from /dev/null (never
# a TTY), so "keyboard" can NEVER detect a wake word as a service -- the
# unit would look "active" forever while doing nothing. `home-assistant-pi
# doctor` will FAIL on this combination, and `home-assistant-pi run` will
# refuse to start rather than run silently unusable. For any real
# deployment, install a production engine's extra dependency
# (`install.sh --wakeword-extra porcupine` or `--wakeword-extra
# openwakeword`, or `pip install --no-cache-dir
# "home-assistant-pi[porcupine]"` / "[openwakeword]"`) and set this to
# porcupine or openwakeword.
HAP_WAKEWORD_ENGINE=keyboard

# Wake word/phrase name (must match an available model for the chosen engine).
HAP_WAKEWORD_KEYWORD=jarvis

# Wake-word detector sensitivity, 0.0 (fewest false accepts) - 1.0 (most sensitive).
HAP_WAKEWORD_SENSITIVITY=0.5

# Only needed when HAP_WAKEWORD_ENGINE=porcupine.
# HAP_PORCUPINE_ACCESS_KEY=

# Optional PortAudio device name/index overrides. Leave blank to use the
# system default input/output device. Run `home-assistant-pi doctor` or
# `scripts/list_audio_devices.py` to see available device names.
HAP_INPUT_DEVICE=
HAP_OUTPUT_DEVICE=

# Microphone sample rate in Hz.
HAP_SAMPLE_RATE=16000

# How often (seconds) to poll the backend for due reminders.
HAP_REMINDER_POLL_INTERVAL_SECONDS=60

# Python logging level: DEBUG | INFO | WARNING | ERROR
HAP_LOG_LEVEL=INFO

# Network request timeout (seconds) and retry count for backend calls.
HAP_REQUEST_TIMEOUT_SECONDS=15
HAP_REQUEST_RETRIES=2

# When "true", allow temporary WAV files to persist on disk after use.
# Keep this "false" (the default) in production: raw audio is never
# persisted, and conversation audio is not retained.
HAP_PERSIST_AUDIO=false
