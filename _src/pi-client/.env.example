# Required: Function endpoint and the same UUID configured in Azure.
HAP_API_BASE_URL=https://YOUR-FUNCTION.azurewebsites.net/api
HAP_DEVICE_GUID=00000000-0000-4000-8000-000000000000

# Leave blank to use compatible defaults from the configured desktop audio session.
HAP_INPUT_DEVICE=
HAP_OUTPUT_DEVICE=

# The bundled model is tuned to recognize "Jarvis" at this threshold. Raise the
# value if your environment causes false activations, or point to a custom
# openWakeWord TFLite model to use a different phrase.
HAP_WAKEWORD_THRESHOLD=0.15
HAP_WAKEWORD_MODEL_PATH=
HAP_VAD_MODE=2
HAP_NO_SPEECH_TIMEOUT_SECONDS=3.0
HAP_FOLLOWUP_TIMEOUT_SECONDS=30.0
HAP_SILENCE_TIMEOUT_SECONDS=1.2
HAP_MAX_COMMAND_SECONDS=30.0
# Re-arm as soon as the sleep prompt finishes. Set a small nonzero delay only if
# speaker echo causes false activations on your hardware.
HAP_PLAYBACK_COOLDOWN_SECONDS=0.0
HAP_LOG_LEVEL=INFO
